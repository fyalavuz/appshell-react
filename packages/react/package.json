{
  "name": "appshell-react",
  "version": "0.5.0",
  "description": "Mobile-first app shell components for React \u2014 Header, Footer, Sidebar, TabBar, SafeArea",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/fyalavuz/appshell-react.git",
    "directory": "packages/react"
  },
  "homepage": "https://fyalavuz.github.io/appshell-react",
  "keywords": [
    "react",
    "appshell",
    "mobile",
    "header",
    "footer",
    "tab-bar",
    "sidebar",
    "safe-area",
    "scroll-aware",
    "tailwindcss"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./motion-framer": {
      "import": {
        "types": "./dist/motion-framer.d.ts",
        "default": "./dist/motion-framer.js"
      },
      "require": {
        "types": "./dist/motion-framer.d.cts",
        "default": "./dist/motion-framer.cjs"
      }
    },
    "./safe-area.css": "./styles/safe-area.css"
  },
  "files": [
    "dist",
    "styles",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "clean": "rm -rf dist",
    "size": "node scripts/size-report.mjs",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "tailwindcss": ">=4.0.0"
  },
  "peerDependenciesMeta": {
    "framer-motion": {
      "optional": true
    }
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.3.0",
    "@eslint/js": "^10.0.1",
    "@storybook/addon-a11y": "^10.5.10",
    "@storybook/addon-docs": "^10.5.10",
    "@storybook/addon-vitest": "^10.5.10",
    "@storybook/react-vite": "^10.5.10",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitest/browser": "^4.1.11",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-storybook": "^10.5.10",
    "framer-motion": "^13.1.1",
    "jsdom": "^30.0.1",
    "lucide-react": "^1.35.0",
    "playwright": "^1.62.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "storybook": "^10.5.10",
    "tailwindcss": "^4.3.3",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "@vitest/browser-playwright": "^4.1.11"
  },
  "dependencies": {
    "clsx": "^2.1.0",
    "tailwind-merge": "^3.6.0"
  }
}
